{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 md:px-8 py-6">

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
        <div class="rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 p-4 flex flex-col items-start animate-fade-slide-up" style="animation-delay: 0ms">
            <div class="w-9 h-9 rounded-lg bg-violet-600 flex items-center justify-center mb-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <p class="text-2xl font-bold text-stone-900 dark:text-stone-100">{{ nbTotal }}</p>
            <p class="text-sm text-stone-500 dark:text-stone-400">Total</p>
        </div>

        <div class="rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 p-4 flex flex-col items-start animate-fade-slide-up" style="animation-delay: 100ms">
            <div class="w-9 h-9 rounded-lg bg-orange-500 flex items-center justify-center mb-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <p class="text-2xl font-bold text-stone-900 dark:text-stone-100">{{ nbAFaire }}</p>
            <p class="text-sm text-stone-500 dark:text-stone-400">En attente</p>
        </div>

        <div class="rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 p-4 flex flex-col items-start animate-fade-slide-up" style="animation-delay: 200ms">    
            <div class="w-9 h-9 rounded-lg bg-blue-500 flex items-center justify-center mb-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <p class="text-2xl font-bold text-stone-900 dark:text-stone-100">{{ nbEnCours }}</p>
            <p class="text-sm text-stone-500 dark:text-stone-400">En cours</p>
        </div>

        <div class="rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 p-4 flex flex-col items-start animate-fade-slide-up" style="animation-delay: 300ms">
            <div class="w-9 h-9 rounded-lg bg-green-500 flex items-center justify-center mb-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <p class="text-2xl font-bold text-stone-900 dark:text-stone-100">{{ nbTermine }}</p>
            <p class="text-sm text-stone-500 dark:text-stone-400">Terminées</p>
        </div>
    </div>

    {% set circonference = 2 * 3.14159 * 50 %}
    {% set lenTermine = circonference * pourcentageTermine / 100 %}
    {% set lenEnCours = circonference * pourcentageEnCours / 100 %}
    {% set lenAFaire = circonference * pourcentageAFaire / 100 %}

    <div class="mt-6 rounded-xl bg-white dark:bg-slate-800 border border-stone-200 dark:border-slate-700 p-6">
        <p class="font-semibold text-stone-700 dark:text-stone-200 mb-4">Taux de complétion</p>

        <div class="flex flex-col sm:flex-row items-center justify-between">
            <div class="relative w-36 h-36 sm:w-48 sm:h-48 shrink-0">
                <svg viewBox="0 0 120 120" class="w-full h-full -rotate-90">
                    <circle cx="60" cy="60" r="50" fill="none" stroke-width="12"
                            class="stroke-stone-200 dark:stroke-slate-700" />

                    <circle cx="60" cy="60" r="50" fill="none" stroke-width="12"
                            stroke-linecap="round"
                            class="{% if lenTermine > 0 %}stroke-green-500 {% else %} stroke-0 {% endif %} donut-segment"
                            stroke-dasharray="{{ lenTermine|round(2) }} {{ (circonference - lenTermine)|round(2) }}"
                            stroke-dashoffset="0" />

                    <circle cx="60" cy="60" r="50" fill="none" stroke-width="12"
                            stroke-linecap="round"
                            class="{% if lenEnCours > 0 %}stroke-blue-500 {% else %} stroke-0 {% endif %} donut-segment"
                            stroke-dasharray="{{ lenEnCours|round(2) }} {{ (circonference - lenEnCours)|round(2) }}"
                            stroke-dashoffset="{{ -lenTermine|round(2) }}" />

                    <circle cx="60" cy="60" r="50" fill="none" stroke-width="12"
                            stroke-linecap="round"
                            class="{% if lenAFaire > 0 %}stroke-orange-500 {% else %} stroke-0 {% endif %} donut-segment"
                            stroke-dasharray="{{ lenAFaire|round(2) }} {{ (circonference - lenAFaire)|round(2) }}"
                            stroke-dashoffset="{{ -(lenTermine + lenEnCours)|round(2) }}" />
                </svg>

                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <p class="text-3xl sm:text-4xl font-bold text-stone-900 dark:text-stone-100">{{ pourcentageTermine|round }}%</p>
                    <p class="text-xs text-stone-400 text-center leading-tight">de tâches<br>terminées</p>
                </div>
            </div>

            <div class="w-full sm:w-52 space-y-3 sm:space-y-4">
                <div class="flex items-center justify-between gap-4">
                    <span class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-green-500 shrink-0"></span>
                        <span class="text-stone-600 dark:text-stone-300 text-sm">Terminées</span>
                    </span>
                    <span class="text-stone-400 text-sm">{{ nbTermine }} ({{ pourcentageTermine|round }}%)</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-blue-500 shrink-0"></span>
                        <span class="text-stone-600 dark:text-stone-300 text-sm">En cours</span>
                    </span>
                    <span class="text-stone-400 text-sm">{{ nbEnCours }} ({{ pourcentageEnCours|round }}%)</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-orange-500 shrink-0"></span>
                        <span class="text-stone-600 dark:text-stone-300 text-sm">En attente</span>
                    </span>
                    <span class="text-stone-400 text-sm">{{ nbAFaire }} ({{ pourcentageAFaire|round }}%)</span>
                </div>
            </div>
        </div>
    </div>
        
</div>
{% endblock %}